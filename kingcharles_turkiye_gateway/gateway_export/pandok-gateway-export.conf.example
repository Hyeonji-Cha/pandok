# Sanitized example only — do not put real credentials in this file.
PANDOK_AWS_EXPORT_ENABLED=1
PANDOK_AWS_EXPORT_URL=https://AWS_INGEST_ENDPOINT_REDACTED/v2/telemetry
PANDOK_AWS_EXPORT_TOKEN_PATH=/etc/pandok-gateway/aws-export-token
PANDOK_AWS_EXPORT_TIMEOUT_SECONDS=3
PANDOK_AWS_EXPORT_MAX_ATTEMPTS=3
PANDOK_AWS_EXPORT_BACKOFF_SECONDS=0.25
